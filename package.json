{
  "name": "rolefit-ats",
  "version": "0.1.0",
  "private": true,
  "description": "Rolefit — AI-assisted Applicant Tracking System (MERN)",
  "scripts": {
    "dev": "concurrently -n server,client -c teal,sand \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start:server": "npm run start --prefix server",
    "build:client": "npm run build --prefix client",
    "test:server": "npm test --prefix server",
    "seed": "npm run seed --prefix server",
    "smoke": "npm run smoke --prefix server",
    "lint:server": "npm run lint --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
