# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# In development, localhost ports (5173/5174/…) are also allowed automatically.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ats
# or Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster/ats

# Auth (used from Day 3)
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Storage (local is the default; set s3 with AWS credentials and a bucket)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
FILE_TOKEN_SECRET=replace_with_a_separate_long_random_string

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# Uploads
MAX_RESUME_SIZE_MB=5

# AI (Week 3)
AI_PROVIDER=openai
OPENAI_API_KEY=
# GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# Email (Week 4)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ATS <noreply@example.com>"

# Feature flags
SEND_REJECTION_EMAILS=false
